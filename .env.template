# ==========================================================
# ArcGIS Online User Deletion Tool
# ==========================================================

# Do not store real passwords in this file or commit it to source control.
# It is listed in .gitignore for that reason.
# Copy this file to .env; do not rename it.
# If no values are supplied, tool will use Python keyring

# URL of your ArcGIS Online organization
AGO_URL=your_ago_url
# Credentials for an ArcGIS Online administrator account
ADMIN_USERNAME=your_admin_account
ADMIN_PASSWORD=your_password
# Optional comma-separated last-login years, each four digits, e.g. 2020,2021
# The --DELETE_USERS_BY_LAST_LOGIN_YEAR command-line option overrides this value.
# Leave blank to disable year-based targeting.
DELETE_USERS_BY_LAST_LOGIN_YEAR=